@{
    ViewBag.Title = "Acerca de";
}
<main aria-labelledby="title">
    <div class="page-heading">
        <div class="eyebrow mb-2">Sobre el proyecto</div>
        <h1 id="title" class="h2 mb-2">@ViewBag.Title</h1>
        <p class="mb-0">Una aplicación ASP.NET MVC para administrar un catálogo de productos.</p>
    </div>
    <section class="content-card">
        <div class="content-card-body">
            <h2 class="h5">Arquitectura MVC</h2>
            <p class="muted-copy mb-0">La aplicación conserva la separación entre modelos, controladores y vistas para mantener un flujo sencillo de mantener.</p>
        </div>
    </section>
</main>
