@{
    ViewBag.Title = "Contacto";
}
<main aria-labelledby="title">
    <div class="page-heading">
        <div class="eyebrow mb-2">¿Necesitas ayuda?</div>
        <h1 id="title" class="h2 mb-2">@ViewBag.Title</h1>
        <p class="mb-0">Conversemos sobre el proyecto y su gestión de productos.</p>
    </div>
    <section class="content-card">
        <div class="content-card-body">
            <address class="mb-0">
                <strong class="d-block mb-2">Piero de la Cruz</strong>
                <a href="mailto:piero.delacruz@example.com">piero.delacruz@example.com</a>
            </address>
        </div>
    </section>
</main>
